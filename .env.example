# Server-only Google OAuth credentials. Never expose these in browser code.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Must exactly match a Google Cloud Console authorised redirect URI.
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/callback
# Use a long random value in production.
SESSION_SECRET=replace-with-a-long-random-secret
# Set true only behind HTTPS (for Oracle/Nginx production deployment).
COOKIE_SECURE=false
